---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'GridPulse - Tailscale Fleet Telemetry & Security Auditor',
  description = 'Real-time telemetry, posture compliance, and security monitoring for Tailscale fleets.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 flex flex-col font-sans">
    <!-- Header Navigation -->
    <header class="sticky top-0 z-40 w-full border-b border-slate-800 bg-slate-950/80 backdrop-blur-md">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <div class="w-9 h-9 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 font-bold text-lg">
            ⚡
          </div>
          <div>
            <a href="/" class="font-bold text-lg tracking-tight text-white hover:text-emerald-400 transition-colors">
              Grid<span class="text-emerald-400">Pulse</span>
            </a>
            <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-800 text-slate-300 border border-slate-700">
              Fleet v1.0
            </span>
          </div>
        </div>

        <nav class="hidden md:flex items-center space-x-6 text-sm font-medium text-slate-400">
          <a href="#overview" class="hover:text-white transition-colors">Health & Status</a>
          <a href="#matrix" class="hover:text-white transition-colors">Fleet Matrix</a>
          <a href="#audit" class="hover:text-white transition-colors">Audit Feed</a>
          <a href="#security" class="hover:text-white transition-colors">Posture & Security</a>
        </nav>

        <div class="flex items-center space-x-3">
          <div class="flex items-center space-x-2 text-xs text-slate-400 bg-slate-900 border border-slate-800 px-3 py-1.5 rounded-full">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <span class="font-mono">FastAPI Backend</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-900 bg-slate-950 py-6 mt-12 text-center text-xs text-slate-500">
      <div class="max-w-7xl mx-auto px-4">
        GridPulse &copy; {new Date().getFullYear()} &mdash; Tailscale Fleet Security Posture, Telemetry & Compliance Engine.
      </div>
    </footer>
  </body>
</html>
