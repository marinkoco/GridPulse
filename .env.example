# PostgreSQL Database Configuration
POSTGRES_USER=gridpulse
POSTGRES_PASSWORD=gridpulse_secret
POSTGRES_DB=gridpulse
POSTGRES_PORT=5432
POSTGRES_HOST=db

# Container Port & Host Binding Configuration (Step 20)
BACKEND_PORT=8000
FRONTEND_PORT=3000
PUBLIC_API_URL=http://localhost:8000

# Database Connection URLs
# For host/local connections (Step 3 migrations, local dev):
DATABASE_URL=postgresql+asyncpg://gridpulse:gridpulse_secret@localhost:5432/gridpulse
# For container-to-container internal network:
# DATABASE_URL=postgresql+asyncpg://gridpulse:gridpulse_secret@db:5432/gridpulse

# Tailscale API Configuration
TAILSCALE_API_KEY=YOUR_TAILSCALE_API_KEY_HERE
TAILSCALE_TAILNET=example.org.github
TAILSCALE_BASE_URL=https://api.tailscale.com
TAILSCALE_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE
TAILSCALE_WEBHOOK_TOLERANCE_SECONDS=300
TAILSCALE_WEBHOOK_VERIFY_SIGNATURE=true
TAILSCALE_WEBHOOK_AUTO_FETCH_ACL=true

# Background Scheduler & Telemetry Polling (Step 6)
TAILSCALE_POLL_INTERVAL_MINUTES=10
TAILSCALE_POLL_ENABLED=true
TAILSCALE_POLL_ON_STARTUP=false

# Version Drift & Key Expiry Posture Settings (Step 8)
TAILSCALE_STABLE_VERSION=1.60.0
KEY_EXPIRY_WARNING_DAYS=14
KEY_EXPIRY_CRITICAL_DAYS=3

# Network Routing & DERP Auditor Settings (Step 9)
# AUTHORIZED_EXIT_NODE_TAGS=["tag:exit-node", "tag:exitnode", "tag:gateway"]
# AUTHORIZED_EXIT_NODE_HOSTNAMES=[]
ALLOW_UNTAGGED_EXIT_NODES=false
DERP_LATENCY_THRESHOLD_MS=150.0

# Device Posture & Compliance Settings (Step 10)
POSTURE_REQUIRE_AUTO_UPDATE=true
POSTURE_REQUIRE_STATE_ENCRYPTED=true
POSTURE_STRICT_MODE=false
POSTURE_AUTO_UPDATE_SEVERITY=high
POSTURE_STATE_ENCRYPTED_SEVERITY=critical

# Geolocation Anomaly Tracker Settings (Step 11)
GEOLOCATION_TRACKING_ENABLED=true
IMPOSSIBLE_TRAVEL_SPEED_THRESHOLD_KMH=800.0
IMPOSSIBLE_TRAVEL_MIN_DISTANCE_KM=100.0
IMPOSSIBLE_TRAVEL_MIN_TIME_SECONDS=60.0
IMPOSSIBLE_TRAVEL_SEVERITY=critical
GEOLOCATION_ALERT_ON_COUNTRY_CHANGE=false

# Tailnet Lock Tracker Settings (Step 12)
TAILNET_LOCK_ENABLED=true
TAILNET_LOCK_ALERT_ON_LOCKED_OUT=true
TAILNET_LOCK_ALERT_ON_UNSIGNED=true
TAILNET_LOCK_ALERT_ON_KEY_ROTATION=true
TAILNET_LOCK_LOCKED_OUT_SEVERITY=critical
TAILNET_LOCK_UNSIGNED_SEVERITY=high

# MagicDNS SSL Monitor Settings (Step 13)
MAGICDNS_SSL_MONITOR_ENABLED=true
MAGICDNS_SSL_POLL_INTERVAL_MINUTES=60
MAGICDNS_SSL_PORT=443
MAGICDNS_SSL_TIMEOUT_SECONDS=10.0
MAGICDNS_SSL_EXPIRY_WARNING_DAYS=30
MAGICDNS_SSL_EXPIRY_CRITICAL_DAYS=7
MAGICDNS_SSL_CONCURRENCY_LIMIT=10
MAGICDNS_SSL_VERIFY_TLS=true
MAGICDNS_SSL_ALERT_ON_EXPIRY=true

